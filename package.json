{
  "name": "repomind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' '*.{json,js}'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' '*.{json,js}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check": "node --env-file-if-exists=.env --import tsx src/cli/db-check.ts",
    "inventory": "node --import tsx src/cli/inventory.ts",
    "technology-profile": "node --import tsx src/cli/technology-profile.ts"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.5",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.8"
  }
}
